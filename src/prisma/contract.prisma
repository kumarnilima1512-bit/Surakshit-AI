// use prisma-next

enum Role {
  ADMIN
  COMMANDER
  OFFICER
  PERSONNEL
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  password  String
  role      Role     @default(PERSONNEL)

  posts     Post[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Unit {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  location    String?
  description String?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model UnitAssignment {
  id           Int      @id @default(autoincrement())
  unitId       Int
  personnelId  Int
  assignedAt   TimestamptzString @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Assessment {
  id          Int      @id @default(autoincrement())
  userId      Int
  stressScore Float
  riskLevel   String

  createdAt   TimestamptzString @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)

  createdAt TimestamptzString @default(now())
}